server {
    # Port
    listen 8080;

    # Main properties
    server_name ${DOMAIN_NAME};

    # Route to backend services
    include /etc/nginx/routes.d/*.conf;

    # Route to frontend service
    location / {
        proxy_pass http://frontend:8080;
        include /etc/nginx/rules.d/restful-proxy-rule.conf;
    }

    # Logs
    access_log /var/log/nginx/nginx_default_access.log;
    error_log /var/log/nginx/nginx_default_error.log;
}