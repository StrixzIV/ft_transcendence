generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:db/auth.db"
}

model Users {

    id                          String  @id @default(uuid())
    username                    String  @unique
    email                       String
    pasword_hash                String?
    totp_encerypted_secret      String? @unique
    twofa_enable                Boolean @default(false)
    google_id                   String? @unique
    profile_url                 String?
    refresh_tokens              RefreshToken[]
    created_at                  DateTime @default(now())

    @@map("users")

}

model RefreshToken {

    token_hash          String   @id   
    user_id             String
    user                Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
    created_at          DateTime
    expires_at          DateTime
    revoked             Boolean  @default(false)
    replaced_by_id      String?  @unique
    replaced_by         RefreshToken? @relation("ReplacedTokens", fields: [replaced_by_id], references: [token_hash])
    replaces            RefreshToken? @relation("ReplacedTokens")

    @@map("refresh_token")

}
