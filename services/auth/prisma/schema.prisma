// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:db/auth.db"
}

model Users {

    id           String   @id @default(uuid())
    username     String   @unique
    email        String
    pasword_hash String?
    google_id    String?  @unique
    profile_url  String?
    created_at   DateTime @default(now())

    @@map("users")

}
